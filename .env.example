# --- SonarQube webhook ---
# Shared secret configured in the SonarQube webhook settings (Administration > Webhooks).
# SonarQube signs each webhook payload with this secret and sends the signature in the
# X-Sonar-Webhook-HMAC-SHA256 header.
SONAR_WEBHOOK_SECRET=changeme

# --- Scanner backend ---
# "sonarqube" = self-hosted SonarQube Community Build (SonarQubeServerClient)
# "sonarqube-cloud" = SonarQube Cloud (SonarQubeCloudClient) - not implemented yet
# (SONAR_MODE "local"/"cloud" is still read as a fallback if this is unset)
SCANNER_TYPE=sonarqube

# Base URL of your SonarQube instance
SONAR_HOST_URL=http://localhost:9000

# User token generated in SonarQube (My Account > Security > Generate Tokens)
SONAR_TOKEN=

# Only used when SONAR_MODE=cloud
SONAR_ORGANIZATION=

# --- Ticket backend ---
# "jira" = Jira Cloud (JiraClient) - the only implementation right now
TICKET_BACKEND=jira

# --- Jira ---
# Base URL of your Jira Cloud site, e.g. https://your-domain.atlassian.net
JIRA_URL=

# Email address of the Jira account the API token belongs to
JIRA_EMAIL=

# API token generated at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Key of the Jira project tickets should be created in, e.g. "SONAR"
JIRA_PROJECT_KEY=
